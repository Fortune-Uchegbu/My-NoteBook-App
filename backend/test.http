### GET ALL NOTES
GET http://localhost:5000/api/notes
###

### CREATE A NEW NOTE (POST)
# Note: We are sending your custom array-of-arrays format!
POST http://localhost:5000/api/notes
Content-Type: application/json

[
    [
        "title",
        "Backend testing one                           "
    ],
    [
        "body",
        "                                                               \n\n            Creating an iterable object!    \n       \n                               "
    ]
]
###


### EDIT A NOTE (PUT)
# Replace the ID below with a real UUID generated by your POST request
PUT http://localhost:5000/api/notes/019e794f-7bc2-7326-b9ed-f27967d4b597
Content-Type: application/json

[
  ["title", "Updated Title"],
  ["body", "This body has been fully updated!"]
]
###


### DELETE A NOTE
# Replace the ID below with a real UUID you want to delete
DELETE http://localhost:5000/api/notes/019e8d10-6972-73ec-a1c5-c0d894c60d5f
###