### GET ALL NOTES
GET http://localhost:5000/api/notes
###

### CREATE A NEW NOTE (POST)
# Note: We are sending your custom array-of-arrays format!
POST http://localhost:5000/api/notes
Content-Type: application/json

[
    [
        "title",
        "Testing persistence with json                           "
    ],
    [
        "body",
        "                                                               \n\n            Creating an POST request!    \n       \n                               "
    ]
]
###


### EDIT A NOTE (PUT)
# Replace the ID below with a real UUID generated by your POST request
PUT http://localhost:5000/api/notes/019ec093-4ee2-74ba-b683-d6569f9519d4
Content-Type: application/json

[
  ["title", "Backend testing two"],
  ["body", "Editing backend testing one!"]
]
###


### DELETE A NOTE
# Replace the ID below with a real UUID you want to delete
DELETE http://localhost:5000/api/notes/019e794f-7bc2-7326-b9ed-f27967d4b597
###